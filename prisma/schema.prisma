datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  plan          Plan      @default(FREE)
  songs         Song[]
  accounts      Account[]
  sessions      Session[]
  practiceSessions PracticeSession[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Song {
  id            String    @id @default(cuid())
  title         String
  artist        String?
  key           String?   // Tonalidad musical (C, Dm, etc)
  timeSignature String?   @default("4/4") // Compás musical (4/4, 3/4, 6/8, etc)
  tempo         Int?      @default(120) // Tempo en BPM
  youtubeUrl    String?   // URL de YouTube o audio de referencia
  genre         String?   // Género musical detectado
  instruments   Json?     // Instrumentos detectados (Json)
  sections      Json?     // Estructura y progresiones de acordes en formato JSON
  content       String    @default("") @db.Text // Letras con acordes
  lyrics        String    @default("") @db.Text // Solo letras (para búsqueda)
  chords        String    @default("") @db.Text // JSON string con acordes
  tags          String[]  @default([])
  isFavorite    Boolean   @default(false)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions      Version[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([title])
  @@index([key])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model Version {
  id        String   @id @default(cuid())
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  key       String
  createdAt DateTime @default(now())

  @@index([songId])
}

enum Instrument {
  GUITARRA
  PIANO
  BAJO
  BATERIA
}

model PracticeSession {
  id           String     @id @default(cuid())
  userId       String
  instrument   Instrument
  duration     Int        // duración en minutos
  book         String?
  exerciseType String?
  scheduledAt  DateTime
  completed    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
